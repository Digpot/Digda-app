// iOS 소셜 로그인 / 서명용 빌드 설정 템플릿.
//
// 이 파일을 같은 폴더에 Secrets.xcconfig 로 복사한 뒤 값을 채운다.
// (Secrets.xcconfig 는 .gitignore 로 커밋되지 않으며, GitHub Actions 는
//  레포 Secrets 에서 이 파일을 생성한다 — .github/workflows/ios-build.yml 참고)
//
// Info.plist 의 $(KAKAO_NATIVE_APP_KEY) 등 치환에 사용된다.

// 카카오 네이티브 앱 키 (Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키)
KAKAO_NATIVE_APP_KEY =

// 네이버 로그인 (Naver Developers > 애플리케이션 > API 설정)
NAVER_CLIENT_ID =
NAVER_CLIENT_SECRET =
NAVER_CLIENT_NAME = 디그팟
// 네이버 콜백 스킴. 보통 "naver" + Client ID 형태.
NAVER_URL_SCHEME = naver$(NAVER_CLIENT_ID)

// 코드 서명용 Apple 개발자 팀 ID (Apple Developer 계정 발급 후 채운다).
// --no-codesign 빌드에서는 비워도 된다.
// DEVELOPMENT_TEAM =

// AdMob 실제 iOS 앱 ID (AdMob 콘솔 > 앱 > 앱 설정). Info.plist GADApplicationIdentifier 치환.
// 비우면 Debug/Release.xcconfig 의 구글 테스트 앱 ID 로 폴백한다.
// (CI 는 GitHub Secret ADMOB_APP_ID_IOS 로 주입)
// ADMOB_APP_ID_IOS = ca-app-pub-XXXX~YYYY
