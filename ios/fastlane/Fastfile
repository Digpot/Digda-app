default_platform(:ios)

# App Store Connect API 키로 배포 인증서·App Store 프로비저닝 프로파일을 직접
# 생성/설치하고, Runner 타깃만 수동 배포 서명으로 전환해 아카이브 후 TestFlight 업로드.
#
# 자동서명은 아카이브를 '개발' 서명으로 시도하는데 CI 엔 등록 기기가 없어
# 개발 프로파일을 못 만든다 → 배포 자산을 직접 만들어 수동 서명한다.
#
# 필요한 환경변수 (워크플로 주입):
#   APPSTORE_API_KEY_ID / APPSTORE_API_ISSUER_ID / APPSTORE_API_KEY_PATH / IOS_TEAM_ID
platform :ios do
  desc "Release IPA 서명 빌드 후 TestFlight 업로드"
  lane :beta do
    team_id = ENV.fetch("IOS_TEAM_ID")
    app_id  = "com.digda.app"

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_API_KEY_PATH")
    )

    # CI 러너용 임시 키체인 (배포 인증서 설치처)
    keychain_name = "ci.keychain"
    keychain_password = "ci-temp-keychain"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    delete_keychain(name: keychain_name) if File.exist?(keychain_path)
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 배포 인증서 생성/설치 (API 키, 수동 .p12 불필요)
    cert(
      api_key: api_key,
      team_id: team_id,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    # App Store 프로비저닝 프로파일 생성/다운로드
    sigh(
      api_key: api_key,
      team_id: team_id,
      app_identifier: app_id
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # Runner 타깃만 수동 배포 서명으로 전환 (Pods 는 그대로 둠)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: app_id,
      profile_name: profile_name,
      targets: ["Runner"]
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          app_id => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
