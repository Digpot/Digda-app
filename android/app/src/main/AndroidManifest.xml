<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ 푸시 알림 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link: digda://invite?code=XXXXXX -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="digda"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!--
            AdMob 앱 ID. 실제 앱 ID 는 레포에 커밋하지 않고 android/admob.properties
            (git 제외) 의 admobAppId 로 주입한다. 파일이 없으면 구글 공식 "테스트" 앱 ID
            로 폴백한다(build.gradle.kts 의 manifestPlaceholders 참고).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!--
            네이버 로그인 SDK 자격 증명.
            문자열 리소스 참조로 두어야 일부 디바이스에서 '_' 시작 값을 null 로
            반환하는 문제를 회피할 수 있다.
        -->
        <meta-data
            android:name="com.naver.sdk.clientId"
            android:value="@string/naver_client_id" />
        <meta-data
            android:name="com.naver.sdk.clientSecret"
            android:value="@string/naver_client_secret" />
        <meta-data
            android:name="com.naver.sdk.clientName"
            android:value="@string/naver_client_name" />
        <!--
            카카오 로그인(카카오계정 웹) 리다이렉트 핸들러.
            카톡 미설치 기기는 loginWithKakaoAccount() 가 커스텀탭으로 동의를 받은 뒤
            kakao{네이티브앱키}://oauth 로 앱에 복귀하는데, 이 intent-filter 가 없으면
            동의 화면에서 멈춘다(옛날 폰=카톡 미설치 다발). 액티비티 자체는
            kakao_flutter_sdk_common 이 선언하지만 스킴 intent-filter 는 앱에서 넣어야 한다.
            앱키는 build.gradle.kts 가 .env 의 KAKAO_NATIVE_APP_KEY 에서 주입한다.
        -->
        <activity
            android:name="com.kakao.sdk.flutter.AuthCodeCustomTabsActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="kakao${kakaoNativeAppKey}"
                    android:host="oauth" />
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ 패키지 가시성: 네이버 앱 감지 (앱간 SSO) -->
        <package android:name="com.nhn.android.search" />
        <!--
            네이버 앱이 설치되어 있지 않은 경우 NaverIdLoginSDK 가 커스텀탭/브라우저
            기반 OAuth 로 폴백한다. 이때 시스템 브라우저(VIEW + https) 가시성이
            필요하다. 빠뜨리면 인증 화면 자체가 뜨지 않고 즉시 user_cancel 로 떨어짐.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
